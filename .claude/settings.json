{
  "permissions": {
    "allow": [
      "Bash(yarn lint)",
      "Bash(npx tsc*)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma migrate status)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(ls*)",
      "Bash(find*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm install --prefer-offline && npx prisma generate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc --noEmit --incremental 2>&1 | head -30"
          }
        ]
      }
    ]
  }
}
